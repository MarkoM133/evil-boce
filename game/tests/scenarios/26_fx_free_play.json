    {"expect": {"phase": "postroll", "to_act": 0, "players.p0.energy": 1}},
    {"move": {"type": "use_ability", "player": 0, "hero": "p0:TA-010", "card": "TA-010", "index": 0}},
    {"expect": {"pending.0.kind": "card", "pending.0.options": ["TA-024"], "heroes.p0:TA-010.cores": {"$size": 0}}},
