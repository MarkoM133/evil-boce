{
  "name": "Action with a stat bonus played in the battle round turns the battle",
  "steps": [
    {"setup": {"seed": 1}},
    {"move": {"type": "mulligan", "player": 0, "keep": true}},
    {"move": {"type": "mulligan", "player": 1, "keep": true}},
    {"set": {
      "heroes.p0:TA-001.zone": "map", "heroes.p0:TA-001.hex": [4, 8],
      "heroes.p1:TB-002.zone": "map", "heroes.p1:TB-002.hex": [6, 8],
      "players.p0.hand": ["TA-040", "TA-041", "TA-042"],
      "players.p0.energy": 2,
      "initiative": 0
    }},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001", "roll": false}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-002", "roll": false}},
    {"pass_round": true},
    {"pass_round": true},
    {"expect": {"phase": "battle", "to_act": 0}},
    {"move": {"type": "play_card", "player": 0, "card": "TA-041"}, "error": "not ready"},
    {"move": {"type": "play_card", "player": 0, "card": "TA-042"}, "error": "no Blue hero"},
    {"move": {"type": "play_card", "player": 0, "card": "TA-040"}},
    {"expect": {"heroes.p0:TA-001.phase_bonus.pwr": 1000, "players.p0.energy": 1, "to_act": 1}},
    {"move": {"type": "pass", "player": 1}},
    {"move": {"type": "pass", "player": 0}},
    {"expect": {
      "pending": {"$size": 1},
      "pending.0.player": 1, "pending.0.amount": 3, "pending.0.targets": ["p1:TB-002"],
      "battles.0.winner_team": 0
    }},
    {"move": {"type": "damage_to", "player": 1, "target": "p1:TB-002"}},
    {"expect": {
      "heroes.p1:TB-002.hp": 7,
      "heroes.p1:TB-002.hex": [8, 8],
      "heroes.p0:TA-001.hp": 10,
      "heroes.p0:TA-001.phase_bonus": {},
      "turn": 2
    }}
  ]
}
