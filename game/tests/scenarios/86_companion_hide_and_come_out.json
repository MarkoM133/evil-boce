{
  "name": "Companion (GDD 10, 2026-11-21): an Assist puts it next to the hero, the hero hides inside in Postroll and is off the table, and it comes out next to the companion when it is activated",
  "steps": [
    {"setup": {"seed": 1}},
    {"move": {"type": "mulligan", "player": 0, "keep": true}},
    {"move": {"type": "mulligan", "player": 1, "keep": true}},
    {"set": {
      "players.p0.hand": ["TF-031", "TX-010"],
      "players.p0.energy": 20, "initiative": 0,
      "heroes.p0:TA-001.zone": "map", "heroes.p0:TA-001.hex": [4, 10],
      "heroes.p1:TB-001.zone": "map", "heroes.p1:TB-001.hex": [16, 12]
    }},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001", "roll": false}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-001", "roll": false}},
    {"expect": {"phase": "preroll", "to_act": 0}},
    {"move": {"type": "play_card", "player": 0, "card": "TF-031"}},
    {"move": {"type": "choose", "player": 0, "value": [5, 10]}},
    {"expect": {"companions": {"$size": 1}, "companions.0.hex": [5, 10], "companions.0.card": "TF-031", "players.p0.assists": ["TF-031"]}},
    {"pass_round": true},
    {"expect": {"phase": "postroll", "to_act": 0}},
    {"move": {"type": "use_ability", "player": 0, "hero": "", "card": "TF-031", "index": 1}},
    {"expect": {"heroes.p0:TA-001.zone": "shelter", "companions.0.inside": "p0:TA-001"}},
    {"move": {"type": "pass", "player": 1}},
    {"move": {"type": "play_card", "player": 0, "card": "TX-010"}, "error": "your activated hero is out"},
    {"pass_round": true},
    {"expect": {"phase": "start", "turn": 2, "heroes.p0:TA-001.zone": "shelter"}},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001", "roll": false, "hex": [6, 10]}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-001", "roll": false}},
    {"expect": {"heroes.p0:TA-001.zone": "map", "heroes.p0:TA-001.hex": [6, 10], "companions.0.inside": "", "companions.0.hex": [5, 10]}}
  ]
}
