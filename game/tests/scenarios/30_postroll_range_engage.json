{
  "name": "Postroll +2 Range starts a battle only when it lasts until the end of the turn",
  "steps": [
    {"setup": {"seed": 1, "decks": [
      {"heroes": ["TA-001", "TA-002", "TA-003"], "cards": {"TX-010": 40}, "stages": [], "cores": []},
      {"heroes": ["TB-001", "TB-002", "TB-003"], "cards": {"TX-010": 40}, "stages": [], "cores": []}
    ]}},
    {"move": {"type": "mulligan", "player": 0, "keep": true}},
    {"move": {"type": "mulligan", "player": 1, "keep": true}},
    {"set": {
      "heroes.p0:TA-001.zone": "map", "heroes.p0:TA-001.hex": [0, 8],
      "heroes.p1:TB-001.zone": "map", "heroes.p1:TB-001.hex": [5, 8],
      "players.p0.hand": ["TA-056", "TA-057"],
      "initiative": 0
    }},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001", "roll": false}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-001", "roll": false}},
    {"pass_round": true},
    {"expect": {"phase": "postroll", "to_act": 0}},
    {"move": {"type": "play_card", "player": 0, "card": "TA-056"}},
    {"expect": {"heroes.p0:TA-001.phase_bonus.rng": 2}},
    {"pass_round": true},
    {"expect": {"turn": 2, "phase": "start"}},
    {"set": {"initiative": 0}},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001", "roll": false}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-001", "roll": false}},
    {"pass_round": true},
    {"expect": {"phase": "postroll", "to_act": 0}},
    {"move": {"type": "play_card", "player": 0, "card": "TA-057"}},
    {"expect": {"heroes.p0:TA-001.turn_bonus.rng": 2}},
    {"pass_round": true},
    {"expect": {"phase": "battle", "battles": {"$size": 1}, "battles.0.heroes": ["p0:TA-001", "p1:TB-001"]}}
  ]
}
