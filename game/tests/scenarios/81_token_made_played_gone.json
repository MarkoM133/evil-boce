        "type": "mulligan",
        "player": 0,
        "keep": true
      }
    },
    {
      "move": {
        "type": "mulligan",
        "player": 1,
        "keep": true
      }
    },
    {
      "set": {
        "heroes.p0:TA-001.zone": "map",
        "heroes.p0:TA-001.hex": [
          4,
          8
