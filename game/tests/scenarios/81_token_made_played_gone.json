        "heroes.p0:TA-001.hp": 4,
        "heroes.p1:TB-002.zone": "map",
        "heroes.p1:TB-002.hex": [
          6,
          8
        ],
        "players.p0.hand": [
          "TA-060",
          "TA-060",
          "TX-010"
        ],
