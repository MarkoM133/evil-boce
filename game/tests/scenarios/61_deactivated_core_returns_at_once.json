{
  "name": "A core an ability deactivates is put back at once, in the same phase, after the ability's own choice",
  "steps": [
    {
      "setup": {
        "seed": 1,
        "decks": [
          {
            "heroes": [
              "TA-010",
              "TA-002",
              "TA-003"
            ],
            "cards": {
              "TX-010": 40
            },
            "stages": [],
            "cores": []
          },
          {
            "heroes": [
              "TB-001",
              "TB-002",
              "TB-003"
            ],
            "cards": {
              "TX-010": 40
            },
            "stages": [],
            "cores": [
              "CR0-001"
            ]
          }
        ]
      }
    },
    {
      "move": {
        "type": "mulligan",
        "player": 0,
        "keep": true
      }
    },
    {
      "move": {
        "type": "mulligan",
        "player": 1,
        "keep": true
      }
    },
    {
      "set": {
        "heroes.p0:TA-010.zone": "map",
        "heroes.p0:TA-010.hex": [
          4,
          8
        ],
        "heroes.p0:TA-010.cores": [
          "core:p1:1"
        ],
        "cores.core:p1:1.place": "hero",
        "cores.core:p1:1.holder": "p0:TA-010",
        "cores.core:p1:1.face_up": true,
        "heroes.p1:TB-003.zone": "map",
        "heroes.p1:TB-003.hex": [
          8,
          2
        ],
        "players.p0.hand": [
          "TA-024",
          "TX-010"
        ],
        "initiative": 0
      }
    },
    {
      "move": {
        "type": "select",
        "player": 0,
        "hero": "p0:TA-010",
        "roll": false
      }
    },
    {
      "move": {
        "type": "select",
        "player": 1,
        "hero": "p1:TB-003",
        "roll": false
      }
    },
    {
      "pass_round": true
    },
    {
      "expect": {
        "phase": "postroll",
        "to_act": 0
      }
    },
    {
      "move": {
        "type": "use_ability",
        "player": 0,
        "hero": "p0:TA-010",
        "card": "TA-010",
        "index": 0
      }
    },
    {
      "expect": {
        "pending.0.kind": "card",
        "pending.1.type": "return_core",
        "pending.1.player": 0,
        "pending.1.core": "core:p1:1",
        "pending": {
          "$size": 2
        }
      }
    },
    {
      "move": {
        "type": "choose",
        "player": 0,
        "value": "TA-024"
      }
    },
    {
      "expect": {
        "phase": "postroll",
        "pending.0.type": "return_core",
        "players.p0.inventory": [
          "core:p1:1"
        ]
      }
    },
    {
      "move": {
        "type": "return_core",
        "player": 0,
        "core": "core:p1:1",
        "hex": [
          5,
          8
        ]
      }
    },
    {
      "expect": {
        "phase": "postroll",
        "pending": {
          "$size": 0
        },
        "players.p0.inventory": {
          "$size": 0
        },
        "cores.core:p1:1.place": "field",
        "cores.core:p1:1.hex": [
          5,
          8
        ]
      }
    }
  ]
}
