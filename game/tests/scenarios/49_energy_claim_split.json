{
  "name": "Energy claims: heroes on two open stages: the player splits all the energy between them",
  "steps": [
    {"setup": {"seed": 1, "settings": {"stage_claim": "energy", "stage_goal": 4}, "decks": [
      {"name": "A", "heroes": ["TA-001", "TA-002", "TA-003"], "cards": {"TX-010": 40},
       "stages": ["TS-001", "TS-002"], "cores": []},
      {"name": "B", "heroes": ["TB-001", "TB-002", "TB-003"], "cards": {"TX-010": 40},
       "stages": ["TS-006"], "cores": []}
    ]}},
    {"move": {"type": "mulligan", "player": 0, "keep": true}},
    {"move": {"type": "mulligan", "player": 1, "keep": true}},
    {"set": {
      "stages.stage:p0:1.center": [4, 8], "stages.stage:p0:1.placed": true, "stages.stage:p0:1.revealed": true,
      "stages.stage:p0:1.progress": {"0": 2},
      "stages.stage:p0:2.center": [12, 8], "stages.stage:p0:2.placed": true, "stages.stage:p0:2.revealed": true,
      "stages.stage:p1:1.placed": false,
      "heroes.p0:TA-001.zone": "map", "heroes.p0:TA-001.hex": [5, 8],
      "heroes.p0:TA-003.zone": "map", "heroes.p0:TA-003.hex": [12, 8],
      "heroes.p1:TB-001.zone": "map", "heroes.p1:TB-001.hex": [8, 1]
    }},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001", "roll": false}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-001", "roll": false}},
    {"set": {"players.p0.energy": 5}},
    {"pass_round": true},
    {"pass_round": true},
    {"expect": {
      "phase": "end",
      "pending.0.type": "stage_energy", "pending.0.player": 0, "pending.0.energy": 5,
      "pending.0.stages": ["stage:p0:1", "stage:p0:2"], "pending.0.goal": 4
    }},
    {"move": {"type": "pass", "player": 0}, "error": "put your energy into the stages first"},
    {"move": {"type": "stage_energy", "player": 0, "split": {"stage:p0:1": 1, "stage:p0:2": 3}}, "error": "all 5 energy goes into the stages (got 4)"},
    {"move": {"type": "stage_energy", "player": 0, "split": {"stage:p0:1": 2, "stage:p1:1": 3}}, "error": "is not a stage your energy can go into"},
    {"move": {"type": "stage_energy", "player": 0, "split": {"stage:p0:1": 6, "stage:p0:2": -1}}, "error": "energy cannot be negative"},
    {"move": {"type": "stage_energy", "player": 0, "split": {"stage:p0:1": 2, "stage:p0:2": 3}}},
    {"expect": {
      "turn": 2, "phase": "start",
      "stages.stage:p0:1.progress.0": 4,
      "stages.stage:p0:1.claimed_by": 0,
      "stages.stage:p0:2.progress.0": 3,
      "stages.stage:p0:2.claimed_by": -1
    }}
  ]
}
