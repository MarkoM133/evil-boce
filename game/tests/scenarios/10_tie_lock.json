{
  "name": "Tied battle locks both heroes; locked heroes cannot be activated next turn",
  "steps": [
    {"setup": {"seed": 1}},
    {"move": {"type": "mulligan", "player": 0, "keep": true}},
    {"move": {"type": "mulligan", "player": 1, "keep": true}},
    {"set": {
      "heroes.p0:TA-001.zone": "map", "heroes.p0:TA-001.hex": [4, 8],
      "heroes.p1:TB-001.zone": "map", "heroes.p1:TB-001.hex": [6, 8]
    }},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001"}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-001"}},
    {"move": {"type": "choice", "player": 0, "roll": false}},
    {"move": {"type": "choice", "player": 1, "roll": false}},
    {"pass_round": true},
    {"pass_round": true},
    {"pass_round": true},
    {"expect": {
      "turn": 2, "phase": "select",
      "heroes.p0:TA-001.hp": 10, "heroes.p1:TB-001.hp": 10,
      "heroes.p0:TA-001.tie_turns": 1, "heroes.p0:TA-001.locked_with": ["p1:TB-001"],
      "heroes.p1:TB-001.tie_turns": 1, "heroes.p1:TB-001.locked_with": ["p0:TA-001"]
    }},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-001"}, "error": "locked"},
    {"move": {"type": "select", "player": 0, "hero": "p0:TA-002"}},
    {"move": {"type": "select", "player": 1, "hero": "p1:TB-002"}},
    {"move": {"type": "choice", "player": 0, "roll": true}},
    {"move": {"type": "choice", "player": 1, "roll": true}},
    {"pass_round": true},
    {"move": {"type": "aim", "player": 0, "dir": [0, -1], "power": 0.2}},
    {"move": {"type": "aim", "player": 1, "dir": [0, 1], "power": 0.2}},
    {"roll": {"thrower": "p0:TA-002", "results": [
      {"ball": "p0:TA-002", "thrown": true, "end_area": 0, "end_hex": [0, 15]},
      {"ball": "p1:TB-002", "thrown": true, "end_area": 0, "end_hex": [8, 1]}
    ]}},
    {"pass_round": true},
    {"pass_round": true},
    {"expect": {"phase": "battle", "battles": {"$size": 1}, "battles.0.heroes": ["p0:TA-001", "p1:TB-001"]}},
    {"pass_round": true},
    {"expect": {
      "turn": 3,
      "heroes.p0:TA-001.tie_turns": 0,
      "heroes.p0:TA-001.hex": [4, 10],
      "heroes.p1:TB-001.hex": [6, 6]
    }}
  ]
}
