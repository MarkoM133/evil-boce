<Defaults>
    <Panel class="TankChessPanel"  color="#8F8478" outline="#635351" outlineSize="2 -2"/>
    <Button class="topButtons" width="25" height="25" rectAlignment="UpperLeft" color="#eeeeee" offsetXY="-3 -3"/>
    <Toggle class="topToggle" width="25" height="25" rectAlignment="UpperRight" color="#eeeeee" offsetXY="-3 -3"/>
    <Text class="UIText" fontSize="18" fontStyle="Bold" color="#000000"/>
    <InputField class="UIInputField" width="50" height="28" fontSize="13" fontStyle="Bold" colors="#dddddd|#FFFFFF|#C8C8C8|rgba(0.78,0.78,0.78,0.5)"/>
    <Button class="bottomButtons" width="25" height="25" rectAlignment="LowerLeft" color="#eeeeee" showAnimation="Grow" hideAnimation="Shrink"/>

    <Button class="controlButtons" height="100" width="40" color="#ffffff66"/>
    <Image class="controlImages" color="#ffffff99" height="95" width="35"/>

    <Image class="mapImage" width="144" height="144" rectAlignment="UpperCenter" offsetXY="0 -3"/>
</Defaults>

<!-- Nova igra -->
<Button id="novaIgraBtn" onClick="novaIgraClick" text="Nova igra"
    width="140" height="36" fontSize="18" fontStyle="Bold"
    rectAlignment="UpperCenter" offsetXY="-160 -70" tooltipPosition="Below"
    color="#202830E6" textColor="#FFFFFF" tooltip="Reset HP, bakugani u bacacke zone, tokeni na start, energy 0, deckovi promijesani, pocinje setup coreova (2x klik)"/>

<!-- Prack a prekidac -->
<Button id="slingBtn" onClick="toggleSlingClick" text="Pracka / ruka"
    width="140" height="36" fontSize="16" fontStyle="Bold"
    rectAlignment="UpperCenter" offsetXY="160 -70" tooltipPosition="Below"
    color="#202830E6" textColor="#FFFFFF" tooltip="Prekidac nacina bacanja za tebe (ili Numpad 3)"/>
<!-- Spremi pozicije -->
<Button id="saveLayoutBtn" onClick="saveLayoutClick" text="Spremi pozicije"
    width="150" height="36" fontSize="16" fontStyle="Bold"
    rectAlignment="UpperCenter" offsetXY="0 -70" tooltipPosition="Below"
    color="#202830E6" textColor="#FFFFFF" tooltip="Zapamti gdje je sve sada; Nova igra vraca na to (2x klik)"/>
<!-- Auto akcije (po igracu) -->
<Button id="autoActionsBtn" onClick="toggleAutoActionsClick" text="Auto akcije"
    width="140" height="36" fontSize="16" fontStyle="Bold"
    rectAlignment="MiddleRight" offsetXY="-10 0" tooltipPosition="Left"
    color="#2A2040E6" textColor="#FFFFFF" tooltip="Ukljuci/iskljuci automatski cilj za tvoje Action karte"/>
<!-- Novi turn -->
<Button id="noviTurnBtn" onClick="noviTurnClick" text="Novi turn"
    width="140" height="36" fontSize="17" fontStyle="Bold"
    rectAlignment="UpperCenter" offsetXY="320 -70" tooltipPosition="Below"
    color="#5A4A10E6" textColor="#FFE680" tooltip="Sljedeci turn: max energy = broj turna (najvise 8), obje strane napunjene (zavrsava i setup coreova)"/>

<!-- Energy: max = broj turna (najvise 8), Novi turn puni obje strane. - potrosi 1, + vrati 1. Tekst puni global.lua (refreshEnergy). -->
<Panel id="energyBar" rectAlignment="UpperCenter" offsetXY="0 -112" width="640" height="34" color="#141A20E6">
  <HorizontalLayout spacing="6" padding="8 8 3 3" childAlignment="MiddleCenter" childForceExpandWidth="false">
    <Text id="energyTurn" text="Prije igre" preferredWidth="96" fontSize="16" fontStyle="Bold" color="#FFFFFF" alignment="MiddleLeft"/>
    <Button onClick="enSpend_p" text="-" preferredWidth="28" fontSize="18" fontStyle="Bold" color="#2A3440" textColor="#FFFFFF" tooltip="Potrosi 1 energy" tooltipPosition="Below"/>
    <Text id="energyP" text="Green/Blue  0 / 0" preferredWidth="180" fontSize="16" fontStyle="Bold" color="#A6A6A6"/>
    <Button onClick="enGive_p" text="+" preferredWidth="28" fontSize="18" fontStyle="Bold" color="#2A3440" textColor="#FFFFFF" tooltip="Vrati 1 energy (recharge efekt ili ispravak)" tooltipPosition="Below"/>
    <Button onClick="enSpend_n" text="-" preferredWidth="28" fontSize="18" fontStyle="Bold" color="#2A3440" textColor="#FFFFFF" tooltip="Potrosi 1 energy" tooltipPosition="Below"/>
    <Text id="energyN" text="Red/Yellow  0 / 0" preferredWidth="180" fontSize="16" fontStyle="Bold" color="#A6A6A6"/>
    <Button onClick="enGive_n" text="+" preferredWidth="28" fontSize="18" fontStyle="Bold" color="#2A3440" textColor="#FFFFFF" tooltip="Vrati 1 energy (recharge efekt ili ispravak)" tooltipPosition="Below"/>
  </HorizontalLayout>
</Panel>
